<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AhamCure – Connect With Us</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --gold: #C9A84C;
      --gold-light: #F0D98A;
      --gold-dark: #8B6914;
      --cream: #FAF7F0;
      --deep: #1A1208;
      --deep2: #2D2010;
      --text: #3D2C10;
      --muted: #8A7050;
      --fb: #1877F2;
      --ig-start: #F58529;
      --ig-mid: #DD2A7B;
      --ig-end: #8134AF;
    }

    html, body {
      height: 100%;
      min-height: 100vh;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--cream);
      color: var(--text);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }

    /* Decorative background */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 50% at 20% 20%, rgba(201,168,76,0.12) 0%, transparent 70%),
        radial-gradient(ellipse 50% 60% at 80% 80%, rgba(201,168,76,0.10) 0%, transparent 70%),
        radial-gradient(ellipse 40% 40% at 50% 50%, rgba(240,217,138,0.06) 0%, transparent 80%);
      pointer-events: none;
      z-index: 0;
    }

    /* Ornamental border frame */
    .frame {
      position: fixed;
      inset: 16px;
      border: 1px solid rgba(201,168,76,0.30);
      border-radius: 4px;
      pointer-events: none;
      z-index: 0;
    }
    .frame::before {
      content: '';
      position: absolute;
      inset: 6px;
      border: 0.5px solid rgba(201,168,76,0.15);
      border-radius: 2px;
    }

    /* Corner ornaments */
    .corner {
      position: fixed;
      width: 40px;
      height: 40px;
      z-index: 1;
      pointer-events: none;
    }
    .corner svg { width: 100%; height: 100%; }
    .corner.tl { top: 10px; left: 10px; }
    .corner.tr { top: 10px; right: 10px; transform: scaleX(-1); }
    .corner.bl { bottom: 10px; left: 10px; transform: scaleY(-1); }
    .corner.br { bottom: 10px; right: 10px; transform: scale(-1); }

    .main {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 48px 32px;
      width: 100%;
      max-width: 520px;
      gap: 0;
    }

    /* Logo mark */
    .logo-mark {
      width: 72px;
      height: 72px;
      background: linear-gradient(135deg, var(--gold-dark), var(--gold), var(--gold-light));
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
      box-shadow:
        0 0 0 8px rgba(201,168,76,0.12),
        0 0 0 16px rgba(201,168,76,0.06);
      animation: pulse 3s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { box-shadow: 0 0 0 8px rgba(201,168,76,0.12), 0 0 0 16px rgba(201,168,76,0.06); }
      50% { box-shadow: 0 0 0 12px rgba(201,168,76,0.18), 0 0 0 24px rgba(201,168,76,0.08); }
    }

    .logo-mark svg { width: 40px; height: 40px; }

    /* Brand name */
    .brand {
      font-family: 'Playfair Display', serif;
      font-size: clamp(36px, 8vw, 52px);
      font-weight: 700;
      letter-spacing: -0.5px;
      color: var(--deep);
      line-height: 1;
      text-align: center;
      margin-bottom: 8px;
    }

    .brand em {
      font-style: italic;
      color: var(--gold-dark);
    }

    .tagline {
      font-size: 13px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--muted);
      font-weight: 400;
      margin-bottom: 40px;
    }

    /* Divider */
    .divider {
      display: flex;
      align-items: center;
      gap: 16px;
      width: 100%;
      margin-bottom: 40px;
    }
    .divider::before, .divider::after {
      content: '';
      flex: 1;
      height: 0.5px;
      background: linear-gradient(to right, transparent, var(--gold), transparent);
      opacity: 0.6;
    }
    .divider-icon {
      width: 8px;
      height: 8px;
      background: var(--gold);
      transform: rotate(45deg);
      opacity: 0.7;
      flex-shrink: 0;
    }

    .connect-text {
      font-size: 14px;
      color: var(--muted);
      text-align: center;
      margin-bottom: 28px;
      font-weight: 300;
      letter-spacing: 0.5px;
    }

    /* Social buttons */
    .social-buttons {
      display: flex;
      flex-direction: column;
      gap: 16px;
      width: 100%;
    }

    .social-btn {
      display: flex;
      align-items: center;
      gap: 18px;
      padding: 20px 28px;
      border-radius: 14px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      font-family: 'DM Sans', sans-serif;
      font-size: 16px;
      font-weight: 500;
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease, opacity 0.2s;
      position: relative;
      overflow: hidden;
    }

    .social-btn::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(255,255,255,0);
      transition: background 0.15s;
    }
    .social-btn:hover::after { background: rgba(255,255,255,0.08); }
    .social-btn:active { transform: scale(0.98) !important; }

    .social-btn:hover {
      transform: translateY(-3px);
    }

    /* Facebook */
    .btn-facebook {
      background: var(--fb);
      color: #fff;
      box-shadow: 0 8px 32px rgba(24,119,242,0.30);
    }
    .btn-facebook:hover {
      box-shadow: 0 12px 40px rgba(24,119,242,0.45);
    }

    /* Instagram */
    .btn-instagram {
      background: linear-gradient(135deg, #F58529 0%, #DD2A7B 50%, #8134AF 100%);
      color: #fff;
      box-shadow: 0 8px 32px rgba(221,42,123,0.30);
    }
    .btn-instagram:hover {
      box-shadow: 0 12px 40px rgba(221,42,123,0.45);
    }

    .btn-icon {
      width: 36px;
      height: 36px;
      background: rgba(255,255,255,0.20);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .btn-icon svg { width: 22px; height: 22px; }

    .btn-content {
      display: flex;
      flex-direction: column;
      text-align: left;
    }
    .btn-label {
      font-size: 17px;
      font-weight: 500;
      color: #fff;
      line-height: 1.2;
    }
    .btn-sub {
      font-size: 12px;
      color: rgba(255,255,255,0.75);
      font-weight: 300;
      margin-top: 2px;
    }

    .btn-arrow {
      margin-left: auto;
      opacity: 0.6;
      transition: transform 0.2s, opacity 0.2s;
    }
    .social-btn:hover .btn-arrow {
      transform: translateX(4px);
      opacity: 1;
    }

    /* Bottom flourish */
    .footer-mark {
      margin-top: 48px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    .footer-dots {
      display: flex;
      gap: 6px;
    }
    .footer-dots span {
      width: 4px;
      height: 4px;
      background: var(--gold);
      border-radius: 50%;
      opacity: 0.4;
    }
    .footer-dots span:nth-child(2) { opacity: 0.7; }
    .footer-dots span:nth-child(3) { opacity: 0.4; }

    .footer-text {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      opacity: 0.6;
    }

    /* Entry animations */
    .main > * {
      animation: fadeUp 0.6s ease both;
    }
    .logo-mark { animation-delay: 0s; }
    .brand { animation-delay: 0.1s; }
    .tagline { animation-delay: 0.15s; }
    .divider { animation-delay: 0.2s; }
    .connect-text { animation-delay: 0.25s; }
    .social-buttons { animation-delay: 0.3s; }
    .footer-mark { animation-delay: 0.4s; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 480px) {
      .main { padding: 40px 20px; }
      .frame { inset: 10px; }
      .corner { width: 32px; height: 32px; }
    }
  </style>
</head>
