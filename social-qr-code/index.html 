<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AhamCure – Coming Soon</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@200;300;400&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --green: #3D6B35;
      --green-light: #5A8F4F;
      --green-pale: #A8C9A0;
      --dark: #0D1A0B;
      --dark2: #162413;
      --text: #E8F0E6;
      --muted: #7A9B72;
      --cream: #F0F5EE;
    }
    html, body { height: 100%; min-height: 100vh; }
    body {
      font-family: 'Jost', sans-serif;
      background: var(--dark);
      color: var(--text);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      overflow: hidden;
      position: relative;
    }
    .bg-orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
    }
    .orb1 {
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(61,107,53,0.20) 0%, transparent 70%);
      top: -150px; left: -150px;
      animation: orbFloat 12s ease-in-out infinite;
    }
    .orb2 {
      width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(61,107,53,0.15) 0%, transparent 70%);
      bottom: -100px; right: -100px;
      animation: orbFloat 12s ease-in-out infinite;
      animation-delay: -6s;
    }
    .orb3 {
      width: 300px; height: 300px;
      background: radial-gradient(circle, rgba(90,143,79,0.10) 0%, transparent 70%);
      top: 50%; left: 50%;
      animation: orbFloat3 10s ease-in-out infinite;
    }
    @keyframes orbFloat {
      0%, 100% { transform: translate(0, 0); }
      33% { transform: translate(30px, -20px); }
      66% { transform: translate(-20px, 30px); }
    }
    @keyframes orbFloat3 {
      0%, 100% { transform: translate(-50%, -50%) scale(1); }
      50% { transform: translate(-50%, -50%) scale(1.2); }
    }
    .deco-line { position: fixed; pointer-events: none; opacity: 0.12; }
    .deco-line.top { top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(to right, transparent, var(--green-light), transparent); }
    .deco-line.bottom { bottom: 0; left: 0; right: 0; height: 1px; background: linear-gradient(to right, transparent, var(--green-light), transparent); }
    .deco-line.left { left: 0; top: 0; bottom: 0; width: 1px; background: linear-gradient(to bottom, transparent, var(--green-light), transparent); }
    .deco-line.right { right: 0; top: 0; bottom: 0; width: 1px; background: linear-gradient(to bottom, transparent, var(--green-light), transparent); }
    .main {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 40px 24px;
      width: 100%;
      max-width: 680px;
    }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      border: 0.5px solid rgba(61,107,53,0.5);
      padding: 8px 20px;
      border-radius: 100px;
      margin-bottom: 40px;
      animation: fadeDown 0.8s ease both;
    }
    .badge-dot {
      width: 6px; height: 6px;
      background: var(--green-light);
      border-radius: 50%;
      animation: blink 2s ease-in-out infinite;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }
    .badge-text {
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--green-pale);
      font-weight: 300;
    }
    .logo-wrap {
      margin-bottom: 32px;
      animation: fadeUp 0.9s ease 0.1s both;
      background: rgba(255,255,255,0.06);
      border-radius: 20px;
      padding: 20px 32px;
      border: 0.5px solid rgba(61,107,53,0.25);
    }
    .logo-wrap img {
      width: 220px;
      height: auto;
      object-fit: contain;
      mix-blend-mode: screen;
      filter: invert(1) sepia(1) hue-rotate(80deg) saturate(0.6) brightness(1.8);
    }
    .gold-rule {
      display: flex;
      align-items: center;
      gap: 16px;
      margin: 8px 0 28px;
      width: 260px;
      animation: fadeUp 0.9s ease 0.2s both;
    }
    .gold-rule::before, .gold-rule::after {
      content: '';
      flex: 1;
      height: 0.5px;
      background: var(--green-light);
      opacity: 0.4;
    }
    .gold-rule-diamond {
      width: 7px; height: 7px;
      background: var(--green-light);
      transform: rotate(45deg);
      opacity: 0.7;
      flex-shrink: 0;
    }
    .tagline {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(18px, 4vw, 26px);
      font-weight: 300;
      font-style: italic;
      color: var(--green-pale);
      letter-spacing: 1px;
      margin-bottom: 10px;
      animation: fadeUp 0.9s ease 0.25s both;
    }
    .sub {
      font-size: 12px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--muted);
      font-weight: 200;
      margin-bottom: 48px;
      animation: fadeUp 0.9s ease 0.3s both;
    }
    .socials {
      display: flex;
      gap: 24px;
      animation: fadeUp 0.9s ease 0.4s both;
    }
    .social-link {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-weight: 300;
      padding: 8px 0;
      border-bottom: 0.5px solid transparent;
      transition: color 0.2s, border-color 0.2s;
    }
    .social-link:hover {
      color: var(--green-pale);
      border-bottom-color: rgba(61,107,53,0.5);
    }
    .social-link svg { width: 14px; height: 14px; fill: currentColor; }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeDown {
      from { opacity: 0; transform: translateY(-16px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .footer {
      position: fixed;
      bottom: 24px;
      left: 0; right: 0;
      text-align: center;
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: rgba(122,155,114,0.35);
      z-index: 2;
    }
    @media (max-width: 480px) {
      .logo-wrap img { width: 160px; }
      .logo-wrap { padding: 16px 24px; }
    }
  </style>
</head>
<body>
